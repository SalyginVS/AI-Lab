[Unit]
Description=RAG MCP Server
After=network-online.target llm-gateway.service
Wants=network-online.target llm-gateway.service

[Service]
Type=simple
User=@LAB_OPERATOR@
WorkingDirectory=@LAB_SERVICE_ROOT@/rag-mcp-server
Environment=PYTHONUNBUFFERED=1
ExecStart=@LAB_SERVICE_ROOT@/rag-mcp-server/.venv/bin/python @LAB_SERVICE_ROOT@/rag-mcp-server/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
