# RB-06, READY_FOR_REVIEW. Скопируйте в приватный файл и заполните пустые значения.
# Назначение: параметры runbooks 10/20/30/40. Значения площадки в git не хранить.
# Порядок: заполнение, проверка, set -a; source <private-file>; set +a.
# Пустое значение не является настройкой. Подстановка в шаблоны выполняется установщиком.

# Абсолютный путь к рабочей копии репозитория.
LAB_BUILD_ROOT=''

# Абсолютный путь к Сборка/artifacts/platform.
LAB_PLATFORM_PACKAGE=''

# Абсолютный путь к Сборка/artifacts/ollama.
LAB_OLLAMA_PACKAGE=''

# Абсолютный путь к Сборка/artifacts/q6.
LAB_Q6_PACKAGE=''

# Каталог ISO и официальных SHA256SUMS/SHA256SUMS.gpg.
LAB_INSTALL_MEDIA_DIR=''

# Имя учётной записи оператора новой площадки.
LAB_OPERATOR=''

# UUID корневого раздела новой площадки.
LAB_ROOT_UUID=''

# UUID EFI-раздела новой площадки.
LAB_EFI_UUID=''

# UUID раздела /srv/ai-test новой площадки.
LAB_DATA_UUID=''

# Одобренный тестовый GPU-контейнер с digest; выбор в RB-10.
LAB_GPU_TEST_IMAGE=''

# Абсолютный путь к проверенному архиву; basename совпадает с receipt.
LAB_OLLAMA_ARCHIVE=''

# Новый абсолютный логический путь backup под --root.
LAB_OLLAMA_BACKUP=''

# Существующий абсолютный путь к резервной копии для отката.
LAB_OLLAMA_RESTORE_FROM=''

# Адрес привязки Ollama. Заполняется только на площадке.
LAB_OLLAMA_BIND=''

# Базовый URL daemon новой площадки для API и импорта.
LAB_OLLAMA_URL=''

# Сокращённый PATH A.3.2; поведение проверяется в RB-10.
OLLAMA_SERVICE_PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'

# Исполняемый файл Ollama на целевой площадке.
LAB_OLLAMA_BIN='/usr/local/bin/ollama'

# Стандартное хранилище Ollama; unit использует default через HOME.
LAB_OLLAMA_MODELS='/usr/share/ollama/.ollama/models'

# Каталог исходных проверенных GGUF/слоёв для runbook 30.
LAB_MODELS_DIR=''

# Каталог evidence; для офлайн-тестов каталог RB-06 с таблицами.
LAB_EVIDENCE_DIR=''

# Только Dell: extract RB-02 для офлайн-проверок.
LAB_CAPTURE_ROOT=''

