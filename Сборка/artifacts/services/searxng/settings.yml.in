use_default_settings: true

general:
  debug: false
  instance_name: "AI Lab Search"

search:
  safe_search: 0
  autocomplete: ""
  formats:
    - html
    - json

server:
  secret_key: "@SEARXNG_SECRET_KEY@"
  limiter: false
  public_instance: false
  image_proxy: false

valkey:
  url: valkey://valkey:6379/0
